{
    "compilerOptions": {
        "outDir": "./public/js",
        "rootDir": "./src/frontend",
        "noImplicitAny": false,
        "module": "ES2020",
        "target": "ES2020",
        "jsx": "react",
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "lib": [
            "ES2020",
            "DOM"
        ]
    },
    "include": [
        "src/frontend/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.definitions.ts",
        "src/frontend/testing/**/*.ts"
    ]
}
